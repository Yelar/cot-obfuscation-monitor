# Copy to .env, set permissions to 0600, and fill only the services you use.
# Never commit .env, checkpoint manifests, logs, or raw evaluation payloads.

# Required for paid GPT-OSS-120B training and sampling.
TINKER_API_KEY=

# Required for GPT-5-mini monitoring and optional corpus generation.
OPENROUTER_API_KEY=

# Optional. Public datasets do not currently require a token.
HF_TOKEN=

# Optional observational logging. The released launchers leave W&B disabled.
WANDB_API_KEY=

# Conservative default for hosted-monitor concurrency. Raise only if your quota permits.
MONITOR_WORKERS=12

# Optional interpreter override. Empty uses REPO/.venv/bin/python.
PYTHON_BIN=
